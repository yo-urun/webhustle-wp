{
  "name": "web-hustle-wp",
  "version": "1.1.0",
  "private": true,
  "description": "Web Hustle — a WordPress + WooCommerce theme modernized with UnoCSS.",
  "scripts": {
    "css": "unocss \"web-hustle/**/*.php\" \"web-hustle/theme.json\" -o web-hustle/assets/uno.css --minify",
    "css:watch": "unocss \"web-hustle/**/*.php\" \"web-hustle/theme.json\" -o web-hustle/assets/uno.css --watch"
  },
  "devDependencies": {
    "@unocss/preset-typography": "^66.11.0",
    "unocss": "^66.11.0"
  }
}
